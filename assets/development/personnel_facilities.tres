tier = 1
display_name = "Barracks & Personnel"
summary = "Barracks: recruit and replenish squads"
description = "Organises personnel at a base. Unlocks the Barracks (trains new squads, refills depleted ones, 32 beds) and the barracks module (8 beds). Recruiting still costs supplies, ammunition and personnel."
