cost = {
"supplies": 300.0
}
time_s = 120.0
structures = Array[StringName]([&"barracks_block", &"barracks", &"medical_station"])
weapons = Array[StringName]([])
roles = Array[StringName]([])
effects = {}
initial = false
available = true
