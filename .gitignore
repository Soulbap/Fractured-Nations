# Godot 4+ specific ignores
.godot/
/android/

# Godot export / build output
/build/
/export/
*.translation
export_credentials.cfg
export_presets.cfg.bak

# Mono / C# (if ever enabled)
.mono/
data_*/
mono_crash.*.json

# Godot AI plugin local update cache (self-ignored too)
addons/.godot_ai_update/

# Benchmark / scratch output
/benchmarks/raw/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~
.vscode/
.idea/

# Windows locked-file replacement temp files (e.g. GDExtension DLL swaps)
~*.TMP
*.TMP

# Scalability test worlds (regenerate with tools/build_world.gd, several hundred MB)
/worlds/scale_*/
/worlds/*_backup/
/worlds/*/terrain_backup/
/scenes/world/scale_*.tscn

# Temporary per-run engine overrides (benchmark experiments)
override.cfg

# Synthetic tiled stress-test maps and large validation worlds (regenerate with tools/)
/worlds/tile_*/
/scenes/world/tile_*.tscn
/worlds/real_*/
/scenes/world/real_*.tscn

# Locked-DLL copies created when the editor reloads a GDExtension
addons/*/bin/~*
/worlds/edit_test_*/
/scenes/world/edit_test_*.tscn

# Python bytecode (Blender tool scripts)
__pycache__/

# Reference-based worlds (WORLD-TERRAIN-01): everything but the config is regenerated by
# tools/terrain_ref/generate.py + tools/build_world.gd (about 1.5 GB).
/worlds/ref_*/*
!/worlds/ref_*/world_config.tres
/scenes/world/ref_*.tscn
/worlds/*.log
# Full-resolution top-down mosaics (8192 px); the 2048 px versions are committed.
/docs/terrain01/shots/*_full.jpg

# Test / import logs written next to the project (--log-file x.log)
/*.log

# test run output captured next to the logs
/*.out
